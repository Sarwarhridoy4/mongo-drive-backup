APP_ENV=production

MONGODB_URI=mongodb://username:password@mongodb:27017
MONGODB_DATABASE=mydatabase

BACKUP_SCHEDULE=0 2 * * *
BACKUP_TIMEZONE=Asia/Dhaka

GOOGLE_DRIVE_FOLDER_ID=

GOOGLE_SHARED_DRIVE_ID=

# Option A: OAuth 2.0 for personal Gmail accounts (recommended)
# Use file path for local development:
GOOGLE_OAUTH_CREDENTIALS_FILE=./secrets/oauth-credentials.json
GOOGLE_OAUTH_TOKEN_FILE=./token.json
# Or use inline JSON for Coolify/deployments without file mounts:
# GOOGLE_OAUTH_CREDENTIALS_JSON={"installed":{...}}
# GOOGLE_OAUTH_TOKEN_JSON={"access_token":"...","refresh_token":"...","token_type":"Bearer"}

# Option B: service account JSON inline or via file (for Google Workspace Shared Drives)
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/google-service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

BACKUP_RETENTION_DAYS=30

TEMP_BACKUP_DIR=/tmp/mongodb-backups

RUN_BACKUP_ON_START=false

WEB_PORT=

# Optional: full path to mongodump binary if it is not in PATH
# MONGODUMP_PATH=/usr/local/bin/mongodump

# Optional: public callback URL for OAuth in Coolify/production.
# Defaults to http://localhost:<WEB_PORT>/oauth2callback when not set.
# GOOGLE_OAUTH_CALLBACK_URL=https://your-domain.com/oauth2callback